<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 광고(AdMob)에만 쓴다. 나머지 기능은 인터넷 없이 동작한다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 블루투스 연결 끊김 감지 (위치 용도로 쓰지 않음) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <application
        android:name=".MyFloorApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyFloor"
        tools:targetApi="36">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <!--
            기존 TWA 앱의 런처 Activity 이름을 그대로 남긴다.
            업데이트 후에도 사용자의 홈 화면 아이콘이 사라지지 않게 하기 위해서다.
        -->
        <activity-alias
            android:name="website.myfloor.twa.LauncherActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 층 선택 팝업. 앱 아이콘 바로가기에서 열기 위해 공개하지만, 사용자가 직접 층을 눌러야만 저장된다. -->
        <activity
            android:name=".quicksave.QuickSaveActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="false"
            android:taskAffinity="website.myfloor.quicksave"
            android:theme="@style/Theme.MyFloor.Translucent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="website.myfloor.action.QUICK_SAVE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.FloorWidgetReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/floor_widget_info" />
        </receiver>

        <!-- ACL_DISCONNECTED 는 시스템만 보낼 수 있는 보호된 브로드캐스트다 -->
        <receiver
            android:name=".system.BluetoothDisconnectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".system.NotificationActionReceiver"
            android:exported="false" />

        <service
            android:name=".system.FloorTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_parking"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="false" />
        </service>
    </application>
</manifest>
