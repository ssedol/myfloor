<!-- 안드로이드 12 이상 백업/기기 이전 규칙 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="myfloor.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="myfloor.db" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
